{
  "manifest_version": 3,
  "name": "云创考勤洞察",
  "description": "在日历上查看云创打卡时间、月平均工时、欠工时和异常日期。",
  "version": "0.4.0",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_title": "云创考勤洞察",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    },
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "scripting",
    "tabs",
    "alarms",
    "offscreen",
    "cookies",
    "notifications"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "host_permissions": [
    "https://yunchuang.talkweb.com.cn/*",
    "https://yunchuanghq.talkweb.com.cn/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://yunchuang.talkweb.com.cn/*",
        "https://yunchuanghq.talkweb.com.cn/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
